# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable

# Server. SERVER_ADDR defaults to loopback on purpose: this API holds CVs and
# has no auth of its own, so it belongs behind a reverse proxy.
SERVER_PORT=8080
SERVER_ADDR=127.0.0.1

# Retrieval (rubric context)
RAGIE_API_KEY=your_ragie_api_key

# How documents are tagged in the Ragie corpus. Retrieved rubrics are selected
# with a $in filter on RAGIE_FILTER_KEY, so these strings must match the
# metadata your documents actually carry. Check GET /retrieval-check: it lists
# the metadata values present in the corpus and how many documents each filter
# matches, which is the fastest way to find a typo here.
RAGIE_FILTER_KEY=type
RAGIE_CV_FILTER=job_desc,cv_rubric
RAGIE_PROJECT_FILTER=case_brief,project_rubric

# LLM provider: opencodego (default) or gemini
LLM_PROVIDER=opencodego

# OpenCode Go (Anthropic Messages API compatible)
OPENCODE_GO_API_KEY=your_opencode_go_api_key
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Reasoning models spend part of this budget on hidden reasoning before emitting
# text; the client starts here and doubles it once if the reply is empty.
OPENCODE_GO_MAX_TOKENS=4096

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Worker Configuration
NUM_WORKERS=5
JOB_QUEUE_SIZE=100
